    "# Euler estable 3D\n",
    "\n",
    "def euler_3d_estable(f, t0, T0, tf, dx, dy, dz, alpha_val):\n",
    "\n",
    "    dt = 0.4 / (alpha_val * (1/dx**2 + 1/dy**2 + 1/dz**2))\n",
    "\n",
    "    n = int((tf - t0) / dt) + 1\n",
    "\n",
    "    t = np.zeros(n+1)\n",
    "    Y = np.zeros((n+1, Nx, Ny, Nz))\n",
    "\n",
    "    t[0] = t0\n",
    "    Y[0] = T0\n",
    "\n",
    "    for i in range(n):\n",
    "\n",
    "        k1 = f(t[i], Y[i])\n",
    "\n",
    "        Y[i+1] = Y[i] + dt*k1\n",
    "\n",
    "        Y[i+1,0,:,:] = Tizq\n",
    "        Y[i+1,-1,:,:] = Tder\n",
    "\n",
    "        Y[i+1,:,0,:] = Tamb\n",
    "        Y[i+1,:,-1,:] = Tamb\n",
    "\n",
    "        Y[i+1,:,:,0] = Tamb\n",
    "        Y[i+1,:,:,-1] = Tamb\n",
    "\n",
    "        t[i+1] = t[i] + dt\n",
    "\n",
    "    return t, Y\n"
