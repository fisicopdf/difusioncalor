    "#Sistema de ecuaciones\n",
    "def f_aluminio(t, T):\n",
    "\n",
    "    dTdt = np.zeros_like(T)\n",
    "\n",
    "    # extremos fijos\n",
    "    dTdt[0] = 0\n",
    "    dTdt[-1] = 0\n",
    "\n",
    "    # nodos interiores\n",
    "    for i in range(1, N-1):\n",
    "        dTdt[i] = alpha*(T[i+1]-2*T[i]+T[i-1])/dx**2\n",
    "\n",
    "    return dTdt\n",
    "    \n",
    "def f_acero(t, T):\n",
    "\n",
    "    dTdt = np.zeros_like(T)\n",
    "\n",
    "    # extremos fijos\n",
    "    dTdt[0] = 0\n",
    "    dTdt[-1] = 0\n",
    "\n",
    "    # nodos interiores\n",
    "    for i in range(1, N-1):\n",
    "        dTdt[i] = alpha_acero*(T[i+1]-2*T[i]+T[i-1])/dx**2\n",
    "\n",
    "    return dTdt\n",
    "\n",
    "#Euler\n",
    "def euler(f, x0, y0, x1, n):\n",
    "    h = (x1 - x0)/n\n",
    "    xi= np.zeros(n+1)\n",
    "    yi= np.zeros((n+1, len(y0)))\n",
    "\n",
    "    xi[0] = x0\n",
    "    yi[0] = y0\n",
    "\n",
    "    for i in range(n):\n",
    "\n",
    "        k1 = f(xi[i], yi[i])\n",
    "\n",
    "        yi[i+1] = yi[i] + h*k1\n",
    "\n",
    "        yi[i+1,0] = Ta\n",
    "        yi[i+1,-1] = Tb\n",
    "\n",
    "        xi[i+1] = xi[i] + h\n",
    "\n",
    "    return xi, yi\n",
    "\n",
    "# Runge-Kutta 2\n",
    "def rungekutta2(f,x0,y0,x1,n):\n",
    "\n",
    "    h =(x1-x0)/n\n",
    "    xi = np.zeros(n+1)\n",
    "    yi = np.zeros((n+1, len(y0)))\n",
    "\n",
    "    xi[0] = x0\n",
    "    yi[0] = y0\n",
    "\n",
    "    for i in range(n):\n",
    "\n",
    "        k1 = f(xi[i], yi[i])\n",
    "        k2 = f(xi[i]+h/2, yi[i]+h*k1/2)\n",
    "\n",
    "        yi[i+1] = yi[i] + h*k2\n",
    "\n",
    "        yi[i+1,0] = Ta\n",
    "        yi[i+1,-1] = Tb\n",
    "\n",
    "        xi[i+1] = xi[i] + h\n",
    "\n",
    "    return xi, yi\n",
    "\n",
    "\n",
    "#Runge-Kutta 4\n",
    "def rungekutta4(f, x0, y0, x1, n):\n",
    "\n",
    "    h = (x1-x0)/n\n",
    "\n",
    "    xi = np.zeros(n+1)\n",
    "    yi = np.zeros((n+1, len(y0)))\n",
    "\n",
    "    xi[0] = x0\n",
    "    yi[0] = y0\n",
    "\n",
    "    for i in range(n):\n",
    "\n",
    "        k1 = f(xi[i], yi[i])\n",
    "        k2 = f(xi[i]+h/2, yi[i]+h*k1/2)\n",
    "        k3 = f(xi[i]+h/2, yi[i]+h*k2/2)\n",
    "        k4 = f(xi[i]+h, yi[i]+h*k3)\n",
    "\n",
    "        yi[i+1] = yi[i] + h*(k1+2*k2+2*k3+k4)/6\n",
    "\n",
    "        yi[i+1,0] = Ta\n",
    "        yi[i+1,-1] = Tb\n",
    "\n",
    "        xi[i+1] = xi[i] + h\n",
    "\n",
    "    return xi, yi\n",
    "\n",
    "\n",
    "# SIMULACION\n",
    "t0 = 0\n",
    "tf = 10000\n",
    "n = 10000\n",
    "\n",
    "te, Ye = euler(f_aluminio, t0, T0, tf, n)\n",
    "trk2, Yrk2 = rungekutta2(f_aluminio, t0, T0, tf, n)\n",
    "trk4, Yrk4 = rungekutta4(f_aluminio, t0, T0, tf, n)\n",
    "\n",
    "te_acero, Ye_acero= euler(f_acero, t0, T0, tf, n)\n",
    "trk2_acero, Yrk2_acero= rungekutta2(f_acero, t0, T0, tf, n)\n",
    "trk4_acero, Yrk4_acero= rungekutta4(f_acero, t0, T0, tf, n)\n",
    "\n",
    "#Graficas\n",
    "#Perfil incial y final de la temperatura del alumnio\n",
    "fig, ax = plt.subplots(1, 3, figsize=(15,5))\n",
    "\n",
    "ax[0].plot(x, T0, 'k--', label='Inicial')\n",
    "ax[0].plot(x, Ye[-1], 'b', label='Final')\n",
    "ax[0].set_title(\"Euler - Aluminio\")\n",
    "ax[0].set_xlabel(\"Posición x (m)\")\n",
    "ax[0].set_ylabel(\"Temperatura (°C)\")\n",
    "ax[0].legend()\n",
    "ax[0].grid(True)\n",
    "\n",
    "ax[1].plot(x, T0, 'k--', label='Inicial')\n",
    "ax[1].plot(x, Yrk2[-1], 'g', label='Final')\n",
    "ax[1].set_title(\"RK2 - Aluminio\")\n",
    "ax[1].set_xlabel(\"Posición x (m)\")\n",
    "ax[1].legend()\n",
    "ax[1].grid(True)\n",
    "\n",
    "ax[2].plot(x, T0, 'k--', label='Inicial')\n",
    "ax[2].plot(x, Yrk4[-1], 'r', label='Final')\n",
    "ax[2].set_title(\"RK4 - Aluminio\")\n",
    "ax[2].set_xlabel(\"Posición x (m)\")\n",
    "ax[2].legend()\n",
    "ax[2].grid(True)\n",
    "\n",
    "fig.suptitle(\"Perfil inicial y final de temperatura en una barra de alumnio\", fontsize=14)\n",
