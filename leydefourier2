    "        (n+1,Nx,Ny,Nz)\n",
    "    )\n",
    "\n",
    "    t[0] = t0\n",
    "    Y[0] = T0\n",
    "\n",
    "    for i in range(n):\n",
    "\n",
    "        k1 = f(t[i],Y[i])\n",
    "\n",
    "        k2 = f(\n",
    "            t[i] + dt/2,\n",
    "            Y[i] + dt*k1/2\n",
    "        )\n",
    "\n",
    "        Y[i+1] = Y[i] + dt*k2\n",
    "\n",
    "        # fronteras\n",
    "\n",
    "        Y[i+1,0,:,:] = Tizq\n",
    "        Y[i+1,-1,:,:] = Tder\n",
