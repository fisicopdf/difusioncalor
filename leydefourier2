    "# Caracterización de la barra\n",
    "L = 1.0                 # longitud (m)\n",
    "N = 50                  # nodos\n",
    "dx = L/(N-1)\n",
    "\n",
    "# vector espacial\n",
    "x = np.linspace(0, L, N)\n",
    "\n",
    "#Condiciones de frontera\n",
    "Ta = 100                # extremo izquierdo\n",
    "Tb = 100                  # extremo derecho\n",
    "\n",
    "#temperatura inicial\n",
    "T0 = np.zeros(N)\n",
    "T0[0] = Ta\n",
    "T0[-1] = Tb"
   ]
