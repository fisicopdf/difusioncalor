    "def f3D_alumnio(t,T):\n",
    "\n",
    "    dTdt = np.zeros_like(T)\n",
    "\n",
    "    dTdt[1:-1,1:-1,1:-1] = alpha*(\n",
    "        (T[2:,1:-1,1:-1] - 2*T[1:-1,1:-1,1:-1] + T[:-2,1:-1,1:-1])/dx**2\n",
    "        +\n",
    "        (T[1:-1,2:,1:-1] - 2*T[1:-1,1:-1,1:-1] + T[1:-1,:-2,1:-1])/dy**2\n",
    "        +\n",
    "        (T[1:-1,1:-1,2:] - 2*T[1:-1,1:-1,1:-1] + T[1:-1,1:-1,:-2])/dz**2\n",
    "    )\n",
    "\n",
    "    return dTdt\n",
    "\n",
    "def f3D_acero(t,T):\n",
    "\n",
    "    dTdt = np.zeros_like(T)\n",
    "\n",
